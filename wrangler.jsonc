{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dashnut-web",
	"compatibility_date": "2026-11-08",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Inherited by every environment: no public *.workers.dev or version/preview URLs,
	// not even for an accidental `wrangler deploy` without `--env`.
	"workers_dev": false,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	// Workers Cache only stores responses that set Cache-Control. Its key is the path
	// (not cookies or Accept-Language), which is why i18n uses the URL strategy.
	"cache": {
		"enabled": true
	},
	"dev": {
		"ip": "0.0.0.0",
		"port": 8787
	},
	// Every page is prerendered: the Worker only serves static assets and the `/de/…` → `/…` style redirects
	// (src/hooks.server.ts). No bindings, no secrets.
	// TODO(domain): the patterns are placeholders, also in vite.config.ts (`origins`). Use the same domain in both.
	"env": {
		"staging": {
			"routes": [{ "pattern": "staging.dashnut.example", "custom_domain": true }]
		},
		"production": {
			"routes": [{ "pattern": "dashnut.example", "custom_domain": true }]
		}
	}
}
