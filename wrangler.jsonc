{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dashnut-web",
	"compatibility_date": "2026-11-08",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Inherited by every environment: no public *.workers.dev or version/preview URLs,
	// not even for an accidental `wrangler deploy` without `--env`.
	"workers_dev": false,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	// Workers Cache only stores responses that set Cache-Control. Its key is the path
	// (not cookies or Accept-Language), which is why i18n uses the URL strategy.
	"cache": {
		"enabled": true
	},
	"dev": {
		"ip": "0.0.0.0",
		"port": 8787
	},
	// Every page is prerendered: the Worker serves static assets, the `/en/…` → `/…` redirects (src/hooks.server.ts) and the
	// contact form submission (src/lib/contact/contact.remote.ts, secret TURNSTILE_SECRET_KEY from `.env.<env>`, see .env.example).
	// Contact form mails (src/lib/contact/deliver.server.ts) via Cloudflare Email Sending, the same sender and recipient as the
	// solo-stack.dev form (solo-stack.dev is onboarded in this account). Pinned sender and recipient; business@ is forwarded to the
	// owner's inbox by Email Routing. Locally the binding is simulated (mail printed to the console, nothing sent).
	"send_email": [
		{
			"name": "CONTACT_MAIL",
			"destination_address": "business@solo-stack.dev",
			"allowed_sender_addresses": ["contact@solo-stack.dev"]
		}
	],
	// Bindings and `vars` are not inherited: repeat them in every environment.
	"env": {
		"staging": {
			"routes": [{ "pattern": "staging.dashnut.app", "custom_domain": true }],
			"send_email": [
				{
					"name": "CONTACT_MAIL",
					"destination_address": "business@solo-stack.dev",
					"allowed_sender_addresses": ["contact@solo-stack.dev"]
				}
			]
		},
		"production": {
			"routes": [{ "pattern": "dashnut.app", "custom_domain": true }],
			"send_email": [
				{
					"name": "CONTACT_MAIL",
					"destination_address": "business@solo-stack.dev",
					"allowed_sender_addresses": ["contact@solo-stack.dev"]
				}
			]
		}
	}
}
