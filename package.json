{
	"name": "dash-web",
	"version": "1.0.0",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"analyze": "vite build --mode analyze",
		"preview": "vite build --mode preview && wrangler dev",
		"staging:deploy": "vite build --mode staging && wrangler deploy --env staging --secrets-file .env.staging",
		"production:deploy": "vite build && wrangler deploy --env production --secrets-file .env.production",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm paraglide:compile && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm paraglide:compile && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix && oxfmt",
		"pkg:update": "sfw pnpm update",
		"pkg:upgrade": "sfw pnpm update --interactive --latest",
		"gen": "wrangler types",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --silent",
		"copy": "node scripts/copy.mjs",
		"screens": "node scripts/screens.mjs"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^3.2.1",
		"@shadcn/lint": "^0.2.5",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^24.19.2",
		"mdsvex": "^0.12.8",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"rolldown": "^1.2.16",
		"sharp": "0.35.5",
		"super-sitemap": "^2.0.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"valibot": "^1.5.0",
		"vite": "^8.3.5",
		"wrangler": "^4.157.0"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"packageManager": "pnpm@11.13.1"
}
