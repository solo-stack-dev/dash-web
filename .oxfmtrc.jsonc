{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 170,
	"svelte": true,
	"sortTailwindcss": {
		"stylesheet": "./src/routes/layout.css"
	},
	// src/content: mdsvex 1.0 Markdown, whose dialect (`*bold*`, `_italic_`) the CommonMark formatter would rewrite
	"ignorePatterns": ["pnpm-lock.yaml", "src/content/", "src/lib/paraglide", "worker-configuration.d.ts", "/static/", "docs/screens/"]
}
